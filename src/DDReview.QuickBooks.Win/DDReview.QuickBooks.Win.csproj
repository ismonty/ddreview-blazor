<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DDReview.QuickBooks.Win</RootNamespace>
    <AssemblyName>DDQuickBooksPoster</AssemblyName>
    <!-- QuickBooks' request processor (QBXMLRP2) is a 32-bit COM server: this program must run as x86. -->
    <PlatformTarget>x86</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDReview.QuickBooks\DDReview.QuickBooks.csproj" />
  </ItemGroup>

</Project>
