<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DDReview.QuickBooks.Win</RootNamespace>
    <AssemblyName>DDQuickBooksPoster</AssemblyName>
    <!-- QuickBooks' request processor (QBXMLRP2) is a 32-bit COM server: this program must run as x86. -->
    <PlatformTarget>x86</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- Shown in the title bar. Publish-Poster.ps1 adds the git commit (-p:SourceRevisionId). -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDReview.QuickBooks\DDReview.QuickBooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public keys the program trusts to sign "Post to QuickBooks" links (public keys only). Ends up next to the exe as DDQuickBooksPoster.keys.json. -->
    <None Include="..\..\deploy\poster-trusted-keys.json" Link="DDQuickBooksPoster.keys.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
