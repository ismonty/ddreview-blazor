@* A round dark-faced gauge (replaces the old Dundas gauges): ticks, labels, needle(s) and a seven-digit readout. *@
@using System.Globalization
@{
    var a = Angle(Value);
    var tip = Pt(a, 62); var tail = Pt(a, -14);
    var tip2 = Pt(Angle(Value2 ?? 0), 60);
}
<svg viewBox="0 0 200 200" class="gauge" role="img" aria-label="@Label" width="@Size" height="@Size">
    <title>@Tip</title>
    <circle cx="100" cy="100" r="96" fill="#8a8f94" /><circle cx="100" cy="100" r="90" fill="#cfd3d6" /><circle cx="100" cy="100" r="85" fill="#0b0d0f" />
    @for (int i = 0; i <= 40; i++)
    {
        var major = i % 4 == 0; var t = Angle(Max * i / 40.0);
        var p1 = Pt(t, 80); var p2 = Pt(t, major ? 70 : 75);
        <line x1="@F(p1.x)" y1="@F(p1.y)" x2="@F(p2.x)" y2="@F(p2.y)" stroke="#f2f2f2" stroke-width="@(major ? "2.2" : "1")" />
    }
    @for (int i = 0; i <= 4; i++)
    {
        var p = Pt(Angle(Max * i / 4.0), 56);
        <g><text x="@F(p.x)" y="@F(p.y + 3)" text-anchor="middle" font-size="9" fill="#f2f2f2">@Lbl(Max * i / 4.0)</text></g>
    }
    <g><text x="100" y="@(Big ? 136 : 130)" text-anchor="middle" font-size="@(Big ? "16" : "11")" fill="#e8e8e8">@Label</text></g>
    @if (Value2 is > 0)
    {
        <line x1="100" y1="100" x2="@F(tip2.x)" y2="@F(tip2.y)" stroke="#8fb4e8" stroke-width="3" stroke-linecap="round" />
    }
    <line x1="@F(tail.x)" y1="@F(tail.y)" x2="@F(tip.x)" y2="@F(tip.y)" stroke="#f7f7f7" stroke-width="4" stroke-linecap="round" />
    <circle cx="100" cy="100" r="9" fill="#9aa0a5" stroke="#444" />
    <rect x="62" y="150" width="76" height="18" rx="3" fill="#d4d6d8" stroke="#555" />
    <g><text x="100" y="164" text-anchor="middle" font-family="monospace" font-size="13" fill="#222">@Readout</text></g>
</svg>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public double Value { get; set; }
    [Parameter] public double? Value2 { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double ReadoutValue { get; set; }
    [Parameter] public string Tip { get; set; } = "";
    [Parameter] public int Size { get; set; } = 150;
    [Parameter] public bool Big { get; set; }
    string Readout => Math.Round(Math.Abs(ReadoutValue)).ToString("0000000", CultureInfo.InvariantCulture);
    double Angle(double v) => -135 + 270 * Math.Clamp(Max <= 0 ? 0 : v / Max, 0, 1);
    static (double x, double y) Pt(double deg, double r) { var rad = deg * Math.PI / 180; return (100 + r * Math.Sin(rad), 100 - r * Math.Cos(rad)); }
    static string F(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);
    static string Lbl(double v) => v >= 1000 ? (v / 1000).ToString("0.#", CultureInfo.InvariantCulture) + "k" : v.ToString("0.##", CultureInfo.InvariantCulture);
}
