@* A shortcut list that sits beside a date box (the browser's own calendar cannot be extended). Choosing one fires OnPick with its key and goes back to the prompt. *@
<select class="datepreset" aria-label="@Label" @onchange="Picked">
    <option value="">@Label…</option>
    @foreach (var (key, text) in Options) { <option value="@key">@text</option> }
</select>
@code {
    [Parameter] public string Label { get; set; } = "Quick Pick";
    [Parameter] public IReadOnlyList<(string Key, string Text)> Options { get; set; } = [];
    [Parameter] public EventCallback<string> OnPick { get; set; }
    private async Task Picked(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (!string.IsNullOrEmpty(key)) await OnPick.InvokeAsync(key);
        StateHasChanged();
    }
    public static readonly IReadOnlyList<(string, string)> StartOptions = [("Yesterday", "Yesterday"), ("LastMonthStart", "Last Month Start"), ("YearStart", "Year Start")];
    public static readonly IReadOnlyList<(string, string)> EndOptions = [("Yesterday", "Yesterday"), ("LastMonthEnd", "Last Month End")];
}
