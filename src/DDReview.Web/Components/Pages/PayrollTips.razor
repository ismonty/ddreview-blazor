@page "/payroll/tips"
@attribute [Authorize]
@using System.Globalization
@using DDReview.Core.Features
@using DDReview.Core.Gl
@using DDReview.Core.Tenancy
@using DDReview.Payroll.Tips
@inject UserContextService Users
@inject TipReportService Svc
@inject FeatureService Features
@inject IJSRuntime JS

<PageTitle>MontySoft DD Review™</PageTitle>
<h1>Tip report – voluntary tips and compulsory service charge</h1>

@if (ctx is null) { <p>Loading…</p> }
else if (!allowed) { <p class="error">You are not authorized for this report.</p> }
else
{
    <div class="no-print">
        <p><a href="/payroll">Back to payroll</a> · <a href="/payroll/tips/letters">Letters</a></p>
        <EditForm Model="this" OnSubmit="RunAsync" FormName="tipreport" class="filters">
            <label>Store
                <select @bind="storeId">
                    <option value="0">Select a store</option>
                    @foreach (var s in stores) { <option value="@s.StoreId">@s.StoreNumber – @s.StoreName</option> }
                </select></label>
            <label>Start <input type="date" @bind="start" /></label>
            <label>End <input type="date" @bind="end" /></label>
            <button type="submit" disabled="@busy">@(busy ? "Working…" : "Run")</button>
            @if (report is not null) { <button type="button" @onclick="Print">Print</button> }
        </EditForm>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
    </div>

    @if (report is not null)
    {
        var vol = report.Voluntary.ToList();
        var comp = report.Compulsory.ToList();
        <section class="tip-page">
            <h2>Voluntary tips tip report</h2>
            <p>@shownStore · @($"{shownStart:MM/dd/yyyy} – {shownEnd:MM/dd/yyyy}")</p>
            <table class="sales">
                <thead>
                    <tr><th rowspan="2">Employee</th><th class="n" colspan="3">Sales voluntary</th><th class="n" rowspan="2">Tip out %</th><th class="n" rowspan="2">Tip out portion</th>
                        <th class="n">Credit card tips</th><th class="n">Less tip out</th><th class="n">Cash tips</th></tr>
                    <tr><th class="n">Cash</th><th class="n">Credit card</th><th class="n">Total</th><th class="n">&nbsp;</th><th class="n">CCT</th><th class="n">CTP</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in vol.GroupBy(l => l.Group))
                    {
                        <tr class="group"><td colspan="9">@g.Key</td></tr>
                        @foreach (var l in g)
                        {
                            <tr><td>@l.EmployeeName - @l.PayrollID</td><td class="n">@M(l.CashSales)</td><td class="n">@M(l.CreditCardSales)</td><td class="n">@M(l.VoluntarySales)</td>
                                <td class="n">@l.TipOutPercent.ToString("0.##", CultureInfo.InvariantCulture)</td><td class="n">@M(l.TipOutOnCashCreditSales)</td>
                                <td class="n">@M(l.CreditCardTipsLessTipOut + l.TipOutOnCashCreditSales)</td><td class="n">@M(l.CreditCardTipsLessTipOut)</td><td class="n">@M(l.Ctp)</td></tr>
                        }
                    }
                </tbody>
                @{ var v = TipTotals.Of(vol); }
                <tfoot><tr class="total"><td>Total</td><td class="n">@M(v.CashSales)</td><td class="n">@M(v.CreditCardSales)</td><td class="n">@M(v.VoluntarySales)</td><td></td>
                    <td class="n">@M(v.TipOutOnCashCreditSales)</td><td class="n">@M(v.CreditCardTipsLessTipOut + v.TipOutOnCashCreditSales)</td><td class="n">@M(v.CreditCardTipsLessTipOut)</td><td class="n">@M(v.Ctp)</td></tr></tfoot>
            </table>
        </section>
        <section class="tip-page">
            <h2>Compulsory service charge report</h2>
            <p>@shownStore · @($"{shownStart:MM/dd/yyyy} – {shownEnd:MM/dd/yyyy}")</p>
            <table class="sales">
                <thead>
                    <tr><th rowspan="2">Employee</th><th class="n" rowspan="2">SC sales</th><th class="n" rowspan="2">Tip out %</th><th class="n" rowspan="2">Tip out portion</th>
                        <th class="n" rowspan="2">Service charges</th><th class="n" rowspan="2">Card fee</th><th class="n">Less tip out and fee</th><th class="n">Voluntary tips on SC</th></tr>
                    <tr><th class="n">SVC</th><th class="n">CCT</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in comp.GroupBy(l => l.Group))
                    {
                        <tr class="group"><td colspan="8">@g.Key</td></tr>
                        @foreach (var l in g)
                        {
                            <tr><td>@l.EmployeeName - @l.PayrollID</td><td class="n">@M(l.ServiceChargeSales)</td><td class="n">@l.TipOutPercent.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                <td class="n">@M(l.TipOutOnServiceChargeSales)</td><td class="n">@M(l.ServiceChargeGross)</td><td class="n">@M(l.ServiceChargeFee)</td>
                                <td class="n">@M(l.Svc)</td><td class="n">@M(l.VoluntaryTipOnServiceCharge)</td></tr>
                        }
                    }
                </tbody>
                @{ var c = TipTotals.Of(comp); }
                <tfoot><tr class="total"><td>Total</td><td class="n">@M(c.ServiceChargeSales)</td><td></td><td class="n">@M(c.TipOutOnServiceChargeSales)</td>
                    <td class="n">@M(c.ServiceChargeGross)</td><td class="n">@M(c.ServiceChargeFee)</td><td class="n">@M(c.Svc)</td><td class="n">@M(c.VoluntaryTipOnServiceCharge)</td></tr></tfoot>
            </table>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "store")] public int StoreParam { get; set; }

    private DDReview.Web.UserContext? ctx;
    private bool allowed, busy;
    private IReadOnlyList<StoreInfo> stores = [];
    private int storeId;
    private DateTime start = DateTime.Today.AddDays(-14), end = DateTime.Today.AddDays(-1);
    private TipReport? report;
    private string? error, shownStore;
    private DateOnly shownStart, shownEnd;

    private static string M(decimal v) => v.ToString("N2", CultureInfo.InvariantCulture);
    private async Task Print() => await JS.InvokeVoidAsync("print");

    protected override async Task OnInitializedAsync()
    {
        ctx = await Users.GetAsync();
        if (ctx is null) return;
        allowed = (ctx.Access.Administrator || ctx.Access.CanSee(ReportKind.Payroll))
                  && await Features.IsEnabledAsync(ctx.ClientConnectionString, ctx.Access, WebFeature.ConsolidatedPayroll);
        if (!allowed) return;
        stores = await StoreLookup.LoadAuthorizedAsync(ctx.ClientConnectionString, ctx.Access, ReportKind.Payroll);
        if (stores.Count == 1) storeId = stores[0].StoreId;
        if (StoreParam != 0 && stores.Any(s => s.StoreId == StoreParam)) storeId = StoreParam;
    }

    private async Task RunAsync()
    {
        if (busy || ctx is null) return;
        busy = true; error = null;
        try
        {
            await Features.RequireAsync(ctx.ClientConnectionString, ctx.Access, WebFeature.ConsolidatedPayroll);
            if (storeId == 0) { error = "Select a store."; return; }
            var s = DateOnly.FromDateTime(start); var e = DateOnly.FromDateTime(end);
            report = await Svc.RunAsync(ctx.ClientConnectionString, stores.Select(x => x.StoreId).ToHashSet(), storeId, s, e);
            shownStore = stores.First(x => x.StoreId == storeId).StoreName; shownStart = s; shownEnd = e;
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException) { error = ex.Message; }
        catch (Microsoft.Data.SqlClient.SqlException) { error = "The report could not be run. Check that script 020 has been applied and the database login may read dbo.fn_TipsByEmployee."; }
        finally { busy = false; }
    }
}
