@page "/gl"
@attribute [Authorize]
@using DDReview.Core.Gl
@using DDReview.Core.Tenancy
@inject UserContextService Users
@inject GlService GlSvc
@inject GlAdjustmentService AdjustSvc
@using DDReview.Web.Components.Gl
@using DDReview.Core.Admin
@inject GlTaxVarianceService TaxSvc
@inject SubmissionReportService SubmissionSvc
@inject DDReview.QuickBooks.Launch.PosterLinkService PosterLinks
@inject NavigationManager Nav
@inject ILogger<Gl> Logger
@inject IJSRuntime JS

@using DDReview.Web.Components.Home

<PageTitle>MontySoft DD Review™</PageTitle>
<h1>General Ledger Review</h1>

@if (ctx is null) { <p>Loading…</p> }
else if (!allowed) { <p class="error">You are not authorized for this report.</p> }
else
{
    <EditForm Model="this" OnSubmit="RunAsync" FormName="gl" class="filters">
        <MultiSelect Caption="Stores" NoneText="None selected" Options="@StoreOptions" OnToggle="t => Toggle(int.Parse(t.Key), t.On)" />
        <label>From <input type="date" @bind="start" @bind:after="StartChanged" /></label>
        <label>To <input type="date" @bind="end" /></label>
        <label>Mode
            <select @bind="mode">
                <option value="summary">Summary (as the old web report)</option>
                <option value="detail">Detail with balance check</option>
                <option value="totals">Totals by account and reference</option>
                <option value="both">Totals at the top, detail below</option>
                <option value="batches">Batch subtotals, with submission reports</option>
            </select>
        </label>
        <label>Show <select @bind="arFlag"><option value="1">GL only</option><option value="2">AR only</option><option value="3">GL and AR</option></select></label>
        <button type="submit" disabled="@busy">@(busy ? "Running…" : "Run")</button>
        @if (PosterLinks.IsConfigured)
        {
            <button type="button" @onclick="PostToQuickBooksAsync" disabled="@(!GlPostingGate.HasData(report, busy))"
                    title="Opens the QuickBooks poster on this computer with the stores, dates and choice of the report shown below. Needs a report on the page. Nothing is posted until you Preview and Post there.">Post to QuickBooks…</button>
            <button type="button" @onclick="DownloadLaunchFileAsync" disabled="@(!GlPostingGate.HasData(report, busy))"
                    title="For when the button above does nothing (a browser or office setting blocks it): saves a small file; double-click it to open the poster.">Download Launch File</button>
            <button type="button" @onclick="DownloadPackageAsync" disabled="@(!GlPostingGate.HasData(report, busy) || packageBusy)"
                    title="Saves everything the poster needs, signed by this site, in one file. Double-click it to open the poster: it then needs no database connection. Good for one day.">@(packageBusy ? "Preparing…" : "Download Package")</button>
        }
    </EditForm>

    @if (posterMsg is not null) { <p class="muted" role="status">@posterMsg</p> }

    @if (error is not null) { <p class="error" role="alert">@error</p> }

    @if (report is not null)
    {
        @if (!report.Balanced)
        {
            <div class="banner bad" role="status">
                OUT OF BALANCE — debits @report.TotalDebit.ToString("N2"), credits @report.TotalCredit.ToString("N2") (difference @report.Difference.ToString("N2"))
            </div>
        }
        @if (report.OutOfBalance.Any())
        {
            <h2>Batches Out of Balance</h2>
            <table><thead><tr><th>Batch</th><th>Date</th><th class="n">Debit</th><th class="n">Credit</th><th class="n">Difference</th><th></th></tr></thead>
            <tbody>@foreach (var b in report.OutOfBalance) {<tr class="@(focusBatch == b.BatchId ? "picked" : null)"><td><button type="button" class="cell sub-link" title="Show only this batch's ledger lines" @onclick="() => FocusBatch(b.BatchId)">@b.BatchId</button></td><td>@b.PostingDate.ToString("d")</td><td class="n">@b.Debit.ToString("N2")</td><td class="n">@b.Credit.ToString("N2")</td><td class="n">@b.Difference.ToString("N2")</td><td><button type="button" class="cell sub-link" @onclick="() => ShowBatchAsync(b)">Submission Report</button></td></tr>}</tbody></table>
        }
        @if (showBatches)
        {
            <h2>Batch Subtotals</h2>
            <table><thead><tr><th>Batch</th><th>Date</th><th>Store</th><th class="n">Debit</th><th class="n">Credit</th><th>Balance</th><th></th></tr></thead>
            <tbody>@foreach (var b in report.Batches) {<tr class="@(b.HasSuspense ? "suspense" : null)"><td><button type="button" class="cell sub-link" title="Show only this batch's ledger lines" @onclick="() => FocusBatch(b.BatchId)">@b.BatchId</button></td><td>@b.PostingDate.ToString("d")</td><td>@(batchStores.GetValueOrDefault(b.BatchId))</td><td class="n">@b.Debit.ToString("N2")</td><td class="n">@b.Credit.ToString("N2")</td><td>@BalanceNote(b.Debit, b.Credit)</td><td><button type="button" class="cell sub-link" @onclick="() => ShowBatchAsync(b)">Submission Report</button></td></tr>}</tbody>
            <tbody class="gl-grand"><tr class="total"><td colspan="3">Grand total @BalanceNote(report.TotalDebit, report.TotalCredit)</td><td class="n">@report.TotalDebit.ToString("N2")</td><td class="n">@report.TotalCredit.ToString("N2")</td><td colspan="2"></td></tr></tbody></table>
        }
    }
    @if (taxChecking) { <p class="muted" role="status">Checking tax rates…</p> }
    @if (taxError is not null) { <p class="muted" role="status">@taxError</p> }
    @if (taxLines is { Count: > 0 })
    {
        var ts = TaxVariance.Summarize(taxLines);
        <div class="banner bad" role="status">
            TAX VARIANCES — @ts.Lines menu item@(ts.Lines == 1 ? "" : "s") sold with a POS tax rate that differs from the mapped rate (sales @ts.Sales.ToString("N2"), tax variance @ts.Variance.ToString("N2"))
        </div>
        <details class="tax-var" open="@(taxLines.Count <= 25)">
            <summary>Tax Variances</summary>
            <table><thead><tr><th>Date</th><th>Store</th><th>Profit Center</th><th>Main Type</th><th>Main Group</th><th>Sale Type</th><th>Menu Item</th><th>PLU</th><th>Exempt</th><th class="n">POS Rate</th><th class="n">Mapped Rate</th><th>Credit Account</th><th>Reference</th><th class="n">Qty</th><th class="n">Amount</th><th class="n">Tax Variance</th></tr></thead>
            <tbody>@foreach (var t in taxLines.Take(500)) {<tr><td>@t.PostingDate.ToString("d")</td><td>@t.StoreName</td><td>@t.ProfitCenter</td><td>@t.MainType</td><td>@t.MainGroup</td><td>@t.SaleType</td><td>@t.MenuItem</td><td>@t.Plu</td><td>@(t.TaxExempt ? "Yes" : "")</td><td class="n">@t.PosRate.ToString("0.####")</td><td class="n">@t.MappedRate.ToString("0.####")</td><td>@t.CreditAccount</td><td>@t.DistReference</td><td class="n">@t.Quantity.ToString("N2")</td><td class="n">@t.Amount.ToString("N2")</td><td class="n">@t.TaxVariance.ToString("N2")</td></tr>}</tbody>
            <tbody class="gl-grand"><tr class="total"><td colspan="14">Total @ts.Lines line@(ts.Lines == 1 ? "" : "s")</td><td class="n">@ts.Sales.ToString("N2")</td><td class="n">@ts.Variance.ToString("N2")</td></tr></tbody></table>
            @if (taxLines.Count > 500) { <p class="muted">Showing the first 500 of @taxLines.Count lines; the totals include all of them.</p> }
        </details>
    }
    @if (totalLines is not null)
    {
        var td = totalLines.Sum(l => l.Debit); var tc = totalLines.Sum(l => l.Credit);
        <h2>Totals, @start.ToString("d") – @end.ToString("d")</h2>
        <p class="muted">Date and batch ignored: lines with the same account, A/R account and reference are added together.</p>
        <table><thead><tr><th>Account</th><th>A/R account</th><th>Reference</th><th class="n">Debit</th><th class="n">Credit</th></tr></thead>
        <tbody>@foreach (var l in totalLines) {<tr class="@(l.Suspense ? "suspense" : null)"><td>@l.Account</td><td>@l.ARAccount</td><td>@l.Reference</td><td class="n">@(l.Debit == 0 ? "" : l.Debit.ToString("N2"))</td><td class="n">@(l.Credit == 0 ? "" : l.Credit.ToString("N2"))</td></tr>}</tbody>
        <tbody class="gl-grand"><tr class="total"><td colspan="3">Total @start.ToString("d") – @end.ToString("d") @BalanceNote(td, tc)</td><td class="n">@td.ToString("N2")</td><td class="n">@tc.ToString("N2")</td></tr></tbody></table>
    }
    @if (detailLines is not null)
    {
        <h2>@detailLines.Count(l => l.Debit != 0 || l.Credit != 0) lines@(focusBatch is int fb ? ", Batch " + fb : "")</h2>
        @if (focusBatch is int fbn)
        {
            <p class="sub-actions"><button type="button" @onclick="ShowAllLines">Show All Lines</button>
                <button type="button" @onclick="() => SeedBatch(fbn)" title="Adds a ledger line to this batch after the sales tax is worked out">Adjust GL</button></p>
        }
        <table><thead><tr><th>Batch</th><th>Date</th><th>Account</th><th>A/R account</th><th>Reference</th><th class="n">Debit</th><th class="n">Credit</th></tr></thead>
        @{ var shown = detailLines.Where(l => l.Debit != 0 || l.Credit != 0).ToList(); }
        @foreach (var day in shown.GroupBy(l => l.PostingDate.Date).OrderBy(g => g.Key))
        {
            var dd = day.Sum(l => l.Debit); var dc = day.Sum(l => l.Credit);
            <tbody class="gl-day">
                @foreach (var l in day) {<tr class="@(l.Suspense ? "suspense" : null)"><td>@l.BatchId</td><td>@l.PostingDate.ToString("d")</td><td class="adj-acct" title="Double-click to add an Adjust GL line for this account" @ondblclick="() => SeedAdjust(l)">@l.Account</td><td>@l.ARAccount</td><td>@l.DistReference</td><td class="n">@(l.Debit == 0 ? "" : l.Debit.ToString("N2"))</td><td class="n">@(l.Credit == 0 ? "" : l.Credit.ToString("N2"))</td></tr>}
                <tr class="total"><td colspan="5">@day.Key.ToString("dddd, MMMM d, yyyy") — total @BalanceNote(dd, dc) <button type="button" class="cell sub-link" @onclick="() => ShowDayAsync(day.Key)">Submission Reports</button></td><td class="n">@dd.ToString("N2")</td><td class="n">@dc.ToString("N2")</td></tr>
                <tr class="gl-gap"><td colspan="7"></td></tr>
            </tbody>
        }
        @{ var gd = shown.Sum(l => l.Debit); var gc = shown.Sum(l => l.Credit); }
        <tbody class="gl-grand">
            <tr class="total"><td colspan="5">@(focusBatch is int ? "Batch subtotal" : "Grand total") @BalanceNote(gd, gc)</td><td class="n">@gd.ToString("N2")</td><td class="n">@gc.ToString("N2")</td></tr>
        </tbody></table>
    }
    @if (summaryLines is not null)
    {
        <h2>@summaryLines.Count(l => l.Debit != 0 || l.Credit != 0) rows</h2>
        <table><thead><tr><th>Store</th><th>Account</th><th>A/R account</th><th>Reference</th><th class="n">Debit</th><th class="n">Credit</th></tr></thead>
        <tbody>@foreach (var l in summaryLines.Where(l => l.Debit != 0 || l.Credit != 0)) {<tr class="@(l.TotalLine == 1 ? "total" : null)"><td>@l.StoreName</td><td>@l.Account</td><td>@l.ARAccount</td><td>@l.DistReference</td><td class="n">@(l.Debit == 0 ? "" : l.Debit.ToString("N2"))</td><td class="n">@(l.Credit == 0 ? "" : l.Credit.ToString("N2"))</td></tr>}</tbody>
        @{ var sr = summaryLines.Where(l => l.TotalLine == 0).ToList(); var sd = sr.Sum(l => l.Debit); var sc = sr.Sum(l => l.Credit); }
        <tbody class="gl-grand"><tr class="total"><td colspan="4">Grand total @BalanceNote(sd, sc)</td><td class="n">@sd.ToString("N2")</td><td class="n">@sc.ToString("N2")</td></tr></tbody></table>
    }
    @if (lastRun is not null)
    {
        <p class="sub-actions"><button type="button" @onclick="ShowAllAsync" disabled="@subsBusy">@(subsBusy ? "Loading…" : "View Submission Reports")</button>
            <button type="button" @onclick="() => adjust = AdjustKind.Sales" title="Changes a sales amount before the sales tax is worked out">Adjust Sales@(adjSalesCount > 0 ? " (" + adjSalesCount + ")" : "")</button>
            <button type="button" @onclick="() => adjust = AdjustKind.Gl" title="Adds a ledger line after the sales tax is worked out">Adjust GL@(adjGlCount > 0 ? " (" + adjGlCount + ")" : "")</button></p>
    }
    @if (adjust is { } ak && lastRun is not null && ctx is not null)
    {
        <GlAdjustPanel Kind="ak" ConnectionString="@ctx.ClientConnectionString" Request="@(new GlRequest(lastRun.Stores, lastRun.Start, lastRun.End, lastRun.ArFlag))"
                       Actor="@AdjustActor()" Seed="@adjustSeed" AllowedStores="@SubmissionReportService.AllowedStores(ctx.Access, DDReview.Core.Tenancy.ReportKind.DebitCredit)" OnClosed="AdjustClosedAsync" />
    }
    @if (subsOpen)
    {
        <div class="sub-overlay" role="dialog" aria-label="Submission reports">
            <div class="sub-panel">
                <div class="sub-bar">
                    <strong>@subsTitle</strong>
                    <span class="sub-bar-buttons">
                        @if (subsViewing is not null && subs is not null && subs.Count > 1)
                        {
                            <button type="button" @onclick="() => Step(-1)" disabled="@(subsViewing == 0)">Previous</button>
                            <button type="button" @onclick="() => Step(1)" disabled="@(subsViewing == subs.Count - 1)">Next</button>
                        }
                        @if (subsViewing is not null && subs is not null && subs.Count > 1) { <button type="button" @onclick="BackToThumbnails">Thumbnails</button> }
                        <button type="button" @onclick="CloseSubs">Close</button>
                    </span>
                </div>
                @if (subsError is not null) { <p class="error" role="alert">@subsError</p> }
                else if (subs is null) { <p>Loading…</p> }
                else if (subs.Count == 0) { <p class="muted">No submission reports for these stores and dates (days with no sales and no receipts are left out).</p> }
                else if (subsViewing is int vi && vi >= 0 && vi < subs.Count)
                {
                    var b = subs[vi];
                    <p class="sub-cap">@SubCaption(b) · <a href="@ImageUrl(b)" target="_blank" rel="noopener">open image in a new tab</a></p>
                    <img class="sub-page" src="@ImageUrl(b)" alt="@("Submission report, " + SubCaption(b))" />
                }
                else
                {
                    <div class="sub-grid">
                        @foreach (var (b, i) in subs.Take(subsShown).Select((b, i) => (b, i)))
                        {
                            <button type="button" class="sub-thumb" @onclick="() => subsViewing = i">
                                <img src="@ImageUrl(b)" loading="lazy" alt="" />
                                <small>@(b.StoreNumber is int n ? n + " – " : "")@b.StoreName<br />@b.PostingDate.ToString("d")</small>
                            </button>
                        }
                    </div>
                    @if (subs.Count > subsShown) { <p><button type="button" @onclick="() => subsShown += 48">Show More (@(subs.Count - subsShown) left)</button></p> }
                    @if (subs.Count >= SubmissionReportService.MaxListed) { <p class="muted">Showing the first @SubmissionReportService.MaxListed reports; narrow the stores or dates to see the rest.</p> }
                }
            </div>
        </div>
    }
}

@code {
    // Changing From moves To: the last day of the month for the 1st of a month, otherwise a week (six days after From).
    private void StartChanged() => end = DDReview.Core.DateRules.EndFor(start);
    private static string BalanceNote(decimal debit, decimal credit) =>
        debit == credit ? "(balanced)" : "(OUT OF BALANCE by " + (debit - credit).ToString("N2") + ")";

    private IReadOnlyList<MultiSelect.Option> StoreOptions => stores.Select(s => new MultiSelect.Option(s.StoreId.ToString(), s.StoreNumber + " – " + s.StoreName, selected.Contains(s.StoreId))).ToList();

    private DDReview.Web.UserContext? ctx;
    private bool allowed;
    private IReadOnlyList<StoreInfo> stores = [];
    private readonly HashSet<int> selected = [];
    private DateTime start = DateTime.Today.AddDays(-7), end = DateTime.Today.AddDays(-1);
    private IReadOnlyList<TaxVarianceLine>? taxLines;
    private bool taxChecking;
    private string? taxError;
    private string mode = "detail";
    private bool showBatches;
    private Dictionary<int, string> batchStores = new();
    private bool busy;
    private IReadOnlyList<GlTotalLine>? totalLines;
    private int arFlag = 3;
    private string? error;
    private GlBalanceReport? report;
    private IReadOnlyList<GlLine>? detailLines;
    private IReadOnlyList<GlSummaryLine>? summaryLines;

    // Submission reports: the stores and dates of the last successful run, and the viewer opened over the page.
    private sealed record RunInfo(string Stores, DateOnly Start, DateOnly End, int ArFlag);
    private RunInfo? lastRun;
    private bool subsOpen, subsBusy;
    private AdjustKind? adjust;
    private AdjustSeed? adjustSeed;
    private IReadOnlyList<GlLine>? keptLines;   // every line of the last run, so a batch can be picked out of it
    private int? focusBatch;
    private string runMode = "";
    private int adjGlCount, adjSalesCount;
    private string subsTitle = "";
    private string? subsError;
    private IReadOnlyList<SubmissionBatch>? subs;
    private int? subsViewing;
    private int subsShown = 48;

    protected override async Task OnInitializedAsync()
    {
        ctx = await Users.GetAsync();
        if (ctx is null) return;
        allowed = ctx.Access.Administrator || ctx.Access.CanSee(ReportKind.DebitCredit);
        if (!allowed) return;
        stores = await StoreLookup.LoadAuthorizedAsync(ctx.ClientConnectionString, ctx.Access, ReportKind.DebitCredit);
        foreach (var s in stores) selected.Add(s.StoreId);
    }

    private void Toggle(int id, bool on) { if (on) selected.Add(id); else selected.Remove(id); }

    private string? posterMsg;

    /// <summary>
    /// Makes a signed, short-lived ddposter:// link for the stores, dates and choice on the page and hands it to the browser, which asks the person's own computer to open the poster.
    /// Only stores this user is authorized for are put in the link (the same check Run makes), and the link never carries a password or connection string.
    /// </summary>
    private async Task PostToQuickBooksAsync()
    {
        var link = await MakePosterLinkAsync();
        if (link is null) return;
        posterMsg = "Opening the QuickBooks poster on this computer. Nothing has been posted: use Preview in the poster first. If nothing opens, use “Download launch file” instead, or start DDQuickBooksPoster.exe once and choose “Register DD Review links”.";
        Nav.NavigateTo(link, forceLoad: true);
    }

    private async Task DownloadLaunchFileAsync()
    {
        var link = await MakePosterLinkAsync();
        if (link is null || lastRun is null) return;
        var text = DDReview.QuickBooks.Launch.PosterLaunchFile.Build(link);
        await JS.InvokeVoidAsync("ddDownload", DDReview.QuickBooks.Launch.PosterLaunchFile.FileNameFor(lastRun.Start.ToDateTime(TimeOnly.MinValue), lastRun.End.ToDateTime(TimeOnly.MinValue)),
            Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(text)), "application/octet-stream");
        posterMsg = "The launch file was saved. Double-click it within a few minutes to open the QuickBooks poster; nothing has been posted. If it has expired, download a new one.";
    }

    /// <summary>
    /// The signed, short-lived link for the report shown on the page (never the filters as they are now), or null with <see cref="posterMsg"/> saying why not.
    /// Only stores this user is authorized for go in; the link never carries a password or connection string. An out-of-balance report is asked about first.
    /// </summary>
    private async Task<string?> MakePosterLinkAsync()
    {
        var request = await PrepareRequestAsync();
        if (request is null || ctx is null) return null;
        if (!PosterLinks.TryCreate(request, ctx.WebUserId, DateTimeOffset.UtcNow, out var link, out var why)) { posterMsg = why; return null; }
        Logger.LogInformation("QuickBooks poster link made for web user {UserId}: {StoreCount} stores, {Start:yyyy-MM-dd} to {End:yyyy-MM-dd}, scope {Scope}", ctx.WebUserId, request.StoreIds.Count, request.Start, request.End, request.Scope);
        return link;
    }

    private bool packageBusy;

    /// <summary>
    /// Builds the signed package file for the report on the page: the same export-package query the poster used to run itself, plus the posting settings, signed by this site.
    /// The poster then needs no database connection. Nothing is posted by downloading it.
    /// </summary>
    private async Task DownloadPackageAsync()
    {
        if (packageBusy) return;
        var request = await PrepareRequestAsync();
        if (request is null || ctx is null) return;
        packageBusy = true; posterMsg = null; StateHasChanged();
        try
        {
            var cs = ctx.ClientConnectionString;
            var names = request.StoreIds.Select(id => stores.FirstOrDefault(s => s.StoreId == id)).Select(s => s is null ? "" : s.StoreNumber + "  " + s.StoreName).ToList();
            var (rows, options, dayZero) = await Task.Run(() => (DDReview.QuickBooks.Sql.SqlPackageSource.Read(cs, request), DDReview.QuickBooks.Sql.SqlPackageSource.LoadOptions(cs), DDReview.QuickBooks.Sql.SqlPackageSource.ReadDayZero(cs)));
            var earliest = DDReview.QuickBooks.Launch.PosterLinkRules.EffectiveEarliest(dayZero);
            if (request.Start < earliest) { posterMsg = $"This database does not accept dates before {earliest:yyyy-MM-dd} (its day 0). Change the From date and run the report again."; return; }
            if (!PosterLinks.TryCreatePackage(request, names, ctx.WebUserId, options, rows, DateTimeOffset.UtcNow, out var file, out var why)) { posterMsg = why; return; }
            Logger.LogInformation("QuickBooks poster package made for web user {UserId}: {StoreCount} stores, {Start:yyyy-MM-dd} to {End:yyyy-MM-dd}, scope {Scope}, {Rows} rows, {Bytes} bytes", ctx.WebUserId, request.StoreIds.Count, request.Start, request.End, request.Scope, rows.Count, file.Length);
            await JS.InvokeVoidAsync("ddDownload", DDReview.QuickBooks.Launch.PosterPackage.FileNameFor(request.Start, request.End), Convert.ToBase64String(file), "application/octet-stream");
            posterMsg = "The package was saved. Double-click it to open the QuickBooks poster; nothing has been posted. It is good for one day and holds this report's figures, so keep it to yourself and delete it when you are done.";
        }
        catch (Exception ex) when (ex is Microsoft.Data.SqlClient.SqlException or InvalidOperationException or TimeoutException)
        {
            Logger.LogWarning(ex, "Could not build the poster package");
            posterMsg = "The package could not be built: " + ex.Message;
        }
        finally { packageBusy = false; }
    }

    /// <summary>
    /// The request for the report shown on the page (never the filters as they are now), or null with <see cref="posterMsg"/> saying why not.
    /// Only stores this user is authorized for are included. An out-of-balance report is asked about first.
    /// </summary>
    private async Task<DDReview.QuickBooks.Sql.PostingRequest?> PrepareRequestAsync()
    {
        posterMsg = null;
        if (ctx is null || !allowed || !PosterLinks.IsConfigured) return null;
        if (lastRun is null || !GlPostingGate.HasData(report, busy)) { posterMsg = "Run the report first; the poster opens with what is shown."; return null; }
        var authorized = stores.Select(s => s.StoreId).ToHashSet();
        var ids = lastRun.Stores.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(t => int.TryParse(t, out var n) ? n : 0).Where(authorized.Contains).Distinct().OrderBy(x => x).ToList();
        if (ids.Count == 0) { posterMsg = "Pick at least one store."; return null; }
        var question = GlPostingGate.BalanceQuestion(report);
        if (question is not null)
        {
            if (!await JS.InvokeAsync<bool>("confirm", question)) { posterMsg = "Nothing was sent to the poster."; return null; }
            Logger.LogWarning("Web user {UserId} used the poster from an out-of-balance report", ctx.WebUserId);
        }
        return new DDReview.QuickBooks.Sql.PostingRequest(ids, lastRun.Start.ToDateTime(TimeOnly.MinValue), lastRun.End.ToDateTime(TimeOnly.MinValue), lastRun.ArFlag);
    }

    private async Task RunAsync()
    {
        if (ctx is null || busy) return;
        error = null; report = null; detailLines = null; summaryLines = null; totalLines = null; lastRun = null; subsOpen = false; showBatches = false; focusBatch = null; keptLines = null; adjust = null; adjGlCount = adjSalesCount = 0; taxLines = null; taxError = null; taxChecking = false;
        if (selected.Count == 0) { error = "Pick at least one store."; return; }
        if (end < start) { error = "The end date is before the start date."; return; }
        busy = true;
        try
        {
            // Only stores this user is authorized for can be sent to SQL: selected ids are re-checked against the access list.
            var ids = selected.Where(stores.Select(s => s.StoreId).ToHashSet().Contains).OrderBy(x => x);
            var req = new GlRequest(string.Join(",", ids), DateOnly.FromDateTime(start), DateOnly.FromDateTime(end), arFlag);
            if (mode == "totals")
            {
                var lines = await GlSvc.GetDetailAsync(ctx.ClientConnectionString, req);
                totalLines = GlTotals.Group(lines);
                report = new GlBalanceReport(totalLines.Sum(l => l.Debit), totalLines.Sum(l => l.Credit), []);
            }
            else if (mode is "detail" or "both" or "batches")
            {
                var lines = await GlSvc.GetDetailAsync(ctx.ClientConnectionString, req);
                report = GlBalance.Compute(lines);
                keptLines = lines; runMode = mode;
                if (mode == "batches")
                {
                    showBatches = true;
                    batchStores = lines.Where(l => l.StoreName is not null).GroupBy(l => l.BatchId)
                        .ToDictionary(g => g.Key, g => string.Join(", ", g.Select(l => (l.StoreNumber is int n ? n + " – " : "") + l.StoreName).Distinct()));
                }
                else detailLines = lines;
                if (mode == "both") totalLines = GlTotals.Group(lines);
            }
            else
            {
                summaryLines = await GlSvc.GetSummaryAsync(ctx.ClientConnectionString, req);
                var rows = summaryLines.Where(l => l.TotalLine == 0).ToList();
                var d = rows.Sum(l => l.Debit); var c = rows.Sum(l => l.Credit);
                report = new GlBalanceReport(d, c, []);
            }
            lastRun = new RunInfo(req.StoreListCsv, req.Start, req.End, req.ArFlag);
        }
        catch (Exception ex) { error = "The query failed: " + ex.Message; }
        finally { busy = false; }
        if (lastRun is not null) { await LoadAdjustCountsAsync(lastRun); await CheckTaxVariancesAsync(lastRun); }
    }

    /// <summary>
    /// The tax rate check runs after the report is on the page, so a slow or failing check never holds the report back. Nothing to show is the normal case.
    /// </summary>
    /// <summary>A click on a batch number: the ledger lines below narrow to that batch, with its own subtotal.</summary>
    private void FocusBatch(int batchId)
    {
        if (keptLines is null) return;
        focusBatch = batchId;
        detailLines = keptLines.Where(l => l.BatchId == batchId).ToList();
    }

    private void ShowAllLines()
    {
        focusBatch = null;
        detailLines = runMode == "batches" ? null : keptLines;
    }

    private void SeedBatch(int batchId)
    {
        adjustSeed = new AdjustSeed(batchId, null, null, null, 0);
        adjust = AdjustKind.Gl;
    }

    /// <summary>Double-click on an account in the detail lines: opens Adjust GL with a new line started for that account.</summary>
    private void SeedAdjust(GlLine l)
    {
        if (l.BatchId <= 0) return;
        adjustSeed = new AdjustSeed(l.BatchId, l.Account, l.DistReference, l.AccountClass, l.DebitCreditFlag ?? 0);
        adjust = AdjustKind.Gl;
    }

    private SetupActor AdjustActor() => new(ctx!.WebUserId, ctx.Access.ClientWebUserId, ctx.UserName, ctx.Access.Administrator, false, null, null, null);

    private async Task LoadAdjustCountsAsync(RunInfo run)
    {
        try
        {
            var d = await AdjustSvc.LoadAsync(ctx!.ClientConnectionString, new GlRequest(run.Stores, run.Start, run.End, run.ArFlag), SubmissionReportService.AllowedStores(ctx.Access, DDReview.Core.Tenancy.ReportKind.DebitCredit));
            adjGlCount = d.Gl.Count; adjSalesCount = d.Sales.Count;
        }
        catch (Exception) { /* the buttons simply show no count; the window itself explains a problem */ }
    }

    /// <summary>Closing the window after a change runs the report again, so the lines, balance and tax check show the adjustments.</summary>
    private async Task AdjustClosedAsync(bool changed)
    {
        adjust = null; adjustSeed = null;
        if (changed) await RunAsync();
    }

    private async Task CheckTaxVariancesAsync(RunInfo run)
    {
        taxChecking = true; StateHasChanged();
        try
        {
            taxLines = await TaxSvc.GetAsync(ctx!.ClientConnectionString, new GlRequest(run.Stores, run.Start, run.End, run.ArFlag));
        }
        catch (Microsoft.Data.SqlClient.SqlException ex) when (ex.Number is 208 or 2812) { taxError = "The tax rate check is not available in this database."; }
        catch (Exception ex) { taxError = "The tax rate check could not be run: " + ex.Message; }
        finally { taxChecking = false; }
    }

    private static string ImageUrl(SubmissionBatch b) => "/gl/submission-image/" + b.BatchId;
    private static string SubCaption(SubmissionBatch b) => (b.StoreNumber is int n ? n + " – " : "") + b.StoreName + ", " + b.PostingDate.ToString("ddd MMM d, yyyy");

    private Task ShowAllAsync() => lastRun is null ? Task.CompletedTask : OpenSubsAsync(lastRun.Start, lastRun.End, "Submission reports, " + lastRun.Start.ToString("d") + " – " + lastRun.End.ToString("d"));

    private Task ShowDayAsync(DateTime day) =>
        OpenSubsAsync(DateOnly.FromDateTime(day), DateOnly.FromDateTime(day), "Submission reports, " + day.ToString("dddd, MMMM d, yyyy"));

    /// <summary>The submission report of one batch: that day's reports, narrowed to the batch.</summary>
    private Task ShowBatchAsync(BatchBalance b) =>
        OpenSubsAsync(DateOnly.FromDateTime(b.PostingDate), DateOnly.FromDateTime(b.PostingDate), "Submission Report, Batch " + b.BatchId + ", " + b.PostingDate.ToString("ddd MMM d, yyyy"), b.BatchId);

    private async Task OpenSubsAsync(DateOnly from, DateOnly to, string title, int? batchId = null)
    {
        if (ctx is null || lastRun is null || subsBusy) return;
        subsBusy = true; subsError = null; subs = null; subsViewing = null; subsShown = 48; subsTitle = title; subsOpen = true;
        try
        {
            subs = await SubmissionSvc.ListAsync(ctx.ClientConnectionString, lastRun.Stores, SubmissionReportService.AllowedStores(ctx.Access, DDReview.Core.Tenancy.ReportKind.DebitCredit), from, to);
            if (batchId is int only)
            {
                subs = subs.Where(x => x.BatchId == only).ToList();
                if (subs.Count == 0) subsError = "There is no submission report for batch " + only + " (days with no sales and no receipts are left out).";
            }
            if (subs.Count == 1) subsViewing = 0;   // one report for that day: open it straight away
        }
        catch (Microsoft.Data.SqlClient.SqlException) { subsError = "Submission reports are not available in this database."; }
        catch (Exception ex) { subsError = "The submission reports could not be loaded: " + ex.Message; }
        finally { subsBusy = false; }
    }

    private void Step(int by) { if (subsViewing is int i && subs is not null) subsViewing = Math.Clamp(i + by, 0, subs.Count - 1); }
    private void BackToThumbnails() => subsViewing = null;
    private void CloseSubs() { subsOpen = false; subsViewing = null; }
}
