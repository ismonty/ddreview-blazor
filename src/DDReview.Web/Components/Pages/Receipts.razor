@page "/receipts"
@attribute [Authorize]
@using System.Data
@using DDReview.Core.Drill
@using DDReview.Core.Gl
@using DDReview.Core.Receipts
@using DDReview.Core.Tenancy
@inject UserContextService Users
@inject ReceiptsService ReceiptsSvc
@inject IJSRuntime JS
@using DDReview.Web.Components.Home

<PageTitle>MontySoft DD Review™</PageTitle>
<h1>Receipts Review</h1>

@if (ctx is null) { <p>Loading…</p> }
else if (!allowed) { <p class="error">You are not authorized for this report.</p> }
else
{
    <EditForm Model="this" OnSubmit="RunAsync" FormName="receipts" class="filters">
        <MultiSelect Caption="Stores" NoneText="None selected" Options="@StoreOptions" OnToggle="t => Toggle(int.Parse(t.Key), t.On)" />
        <MultiSelect Caption="View by" NoneText="None selected" Options="@DimOptions" OnToggle="t => ToggleDim(Enum.Parse<ReceiptsDimensions>(t.Key), t.On)" />
        <label>Starting Date <input type="date" @bind="start" @bind:after="StartChanged" /></label>
        <DatePreset Label="Start Shortcuts" Options="DatePreset.StartOptions" OnPick="StartPick" />
        <label>Ending Date <input type="date" @bind="end" @bind:after="EndChanged" /></label>
        <DatePreset Label="End Shortcuts" Options="DatePreset.EndOptions" OnPick="EndPick" />
        <button type="submit" disabled="@busy">@(busy ? "Running…" : "Submit")</button>
    </EditForm>

    @if (error is not null) { <p class="error" role="alert">@error</p> }

    @if (result is not null)
    {
        <p>@result.Rows.Count record(s)</p>
        @if (state.Filters.Count > 0)
        {
            <FilterBoxes Boxes="Boxes()" OnShowAll="k => Act(st => st.ShowAll(k))" />
        }
        <table class="receipts">
            <thead>
                <tr>
                    <th></th>
                    @foreach (var l in Leading)
                    {
                        var dc = DrillState.ForDisplay(Cat, l.Column);
                        if (dc is not null)
                        {
                            <DrillHeader Title="@l.Label" Dimension="true" Buttons="@(l.Column == dc.Display[^1])" Filtered="@state.Filters.ContainsKey(dc.Key)"
                                         NextTitle="@dc.NextKey" Mark="@Mark(l.Label)" OnTitle="() => Act(s => s.ShowOnly(dc.Key))" OnUp="() => Act(s => s.DrillUp(dc.Key))"
                                         OnRight="() => Act(s => s.DrillRight(Cat, dc.Key))" OnShowAll="() => Act(s => s.ShowAll(dc.Key))" OnSort="() => state.Sort(l.Label, false)" />
                        }
                        else { <DrillHeader Title="@l.Label" Sortable="true" Mark="@Mark(l.Label)" OnSort="() => state.Sort(l.Label, false)" /> }
                    }
                    @if (weekdays)
                    {
                        <th></th>
                        @foreach (var d in ReceiptsWeekdays.Days) { <th class="n">@d</th> }
                        <th class="n">
                            <select aria-label="Sort by" @onchange="e => SortWeek(e.Value?.ToString())">
                                <option value="">Sort by…</option>
                                @foreach (var l in ReceiptsWeekdays.Lines.Select(x => x.Label).Distinct()) { <option value="@l" selected="@(state.SortHeader == WeekKey(l))">@l</option> }
                            </select>
                        </th>
                    }
                    else
                    {
                    @foreach (var c in ReceiptsLayout.Columns)
                    {
                        <th class="n stack">@foreach (var line in c.Lines) {<div><button type="button" class="hlink" title="Sort by this" @onclick="() => state.Sort(LineKey(c, line), true)">@line.Label@Mark(LineKey(c, line))</button></div>}</th>
                    }
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in Ordered())
                {
                    <tr>
                        <td class="sel"><input type="checkbox" title="Select this row" checked="@checkedRows.Contains(row)" @onchange="e => Check(row, (bool)e.Value!)" /></td>
                        @foreach (var l in Leading)
                        {
                            var dc = DrillState.ForDisplay(Cat, l.Column);
                            <td>@if (dc is not null && CanClick(row, dc)) { <button type="button" class="cell" @onclick="() => RowClick(dc, row)">@Text(row, l.Column)</button> } else { @Text(row, l.Column) }</td>
                        }
                        @if (weekdays)
                        {
                            <td class="n stack wklabels">@foreach (var l in ReceiptsWeekdays.Lines) {<div class="@(l.Bold ? "b" : null)">@l.Label</div>}</td>
                            @for (var d = 0; d < 8; d++)
                            {
                                var dd = d;
                                <td class="n stack">@foreach (var l in ReceiptsWeekdays.Lines) {<div class="@(l.Bold ? "b" : null)">@ReceiptsWeekdays.Cell(row, l, dd)</div>}</td>
                            }
                        }
                        else
                        {
                        @foreach (var c in ReceiptsLayout.Columns)
                        {
                            <td class="n stack">@foreach (var line in c.Lines) {<div class="@(line.Bold ? "b" : null)">@ReceiptsLayout.Format(row, line)</div>}</td>
                        }
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                @{ var sums = ReceiptsLayout.Sums(result); }
                <tr class="total">
                    <td>Total</td>
                    @foreach (var l in Leading) { <td></td> }
                    @if (weekdays)
                    {
                        var wsums = ReceiptsWeekdays.Sums(result);
                        <td class="n stack wklabels">@foreach (var l in ReceiptsWeekdays.Lines) {<div class="@(l.Bold ? "b" : null)">@l.Label</div>}</td>
                        @for (var d = 0; d < 8; d++)
                        {
                            var dd = d;
                            <td class="n stack">@foreach (var l in ReceiptsWeekdays.Lines) {<div class="@(l.Bold ? "b" : null)">@ReceiptsWeekdays.Cell(wsums, l, dd)</div>}</td>
                        }
                    }
                    else
                    {
                    @foreach (var c in ReceiptsLayout.Columns)
                    {
                        <td class="n stack">@foreach (var line in c.Lines) {<div class="@(line.Bold ? "b" : null)">@ReceiptsLayout.FormatTotal(sums, line)</div>}</td>
                    }
                    }
                </tr>
            </tfoot>
        </table>
        <ReportButtons Busy="busy" ShowWeekdaysToggle="true" Weekdays="weekdays" OnToggleWeekdays="() => weekdays = !weekdays" OnPrevious="() => Shift(-1)" OnNext="() => Shift(1)" OnExcel="ExcelAsync" />
    }
}

@code {
    // Changing From moves To: the last day of the month for the 1st of a month, otherwise a week (six days after From).
    private void StartChanged() => end = DDReview.Core.DateRules.EndFor(start, DDReview.Core.DateRules.Yesterday);
    private void StartPick(string key) => (start, end) = DDReview.Core.DateRules.ApplyStart(Enum.Parse<DDReview.Core.DateRules.StartPreset>(key), end, DateTime.Today);
    private void EndPick(string key) => (start, end) = DDReview.Core.DateRules.ApplyEnd(Enum.Parse<DDReview.Core.DateRules.EndPreset>(key), start, DateTime.Today);
    private void EndChanged() => start = DDReview.Core.DateRules.StartFor(start, end);   // an end before the start pulls the start back to it
    private DataRow? header;
    private IReadOnlyList<FilterBox> Boxes() => FilterHeader.Boxes(header, result, Cat, state.Filters.Keys);

    private IReadOnlyList<MultiSelect.Option> StoreOptions => stores.Select(s => new MultiSelect.Option(s.StoreId.ToString(), s.StoreNumber + " – " + s.StoreName, selected.Contains(s.StoreId))).ToList();
    private IReadOnlyList<MultiSelect.Option> DimOptions => Choices.Select(d => new MultiSelect.Option(d.Value.ToString(), d.Label, state.Flags.Contains(d.Value.ToString()))).ToList();

    private record Choice(ReceiptsDimensions Value, string Label);
    private record Lead(string Label, string Column, ReceiptsDimensions Dim);
    private static readonly Choice[] Choices =
    [
        new(ReceiptsDimensions.Store, "Store"), new(ReceiptsDimensions.StoreGroup, "Store group"), new(ReceiptsDimensions.ProfitCenter, "Profit center"),
        new(ReceiptsDimensions.ReceiptClass, "Receipt class"), new(ReceiptsDimensions.ReceiptType, "Receipt type"),
        new(ReceiptsDimensions.Cashier, "Cashier"), new(ReceiptsDimensions.CashierStaffDepartment, "Cashier department"),
        new(ReceiptsDimensions.Server, "Server"), new(ReceiptsDimensions.ServerStaffDepartment, "Server department"),
        new(ReceiptsDimensions.CheckNumber, "Check"), new(ReceiptsDimensions.CreditCardBatchNumber, "Card batch"),
        new(ReceiptsDimensions.CashierSessionNumber, "Cashier session"), new(ReceiptsDimensions.DayName, "Day"),
        new(ReceiptsDimensions.WeekName, "Week"), new(ReceiptsDimensions.DayHourNumber, "Hour"),
    ];
    private IEnumerable<Lead> Leading => AllLeading.Where(l => ranDims.HasFlag(l.Dim));
    private static readonly Lead[] AllLeading =
    [
        new("Store group", "StoreGroupName", ReceiptsDimensions.StoreGroup), new("Store #", "StoreNumber", ReceiptsDimensions.Store),
        new("Store name", "StoreName", ReceiptsDimensions.Store), new("Profit center", "ProfitCenter", ReceiptsDimensions.ProfitCenter),
        new("Receipt class", "ReceiptClass", ReceiptsDimensions.ReceiptClass), new("Receipt type", "ReceiptType", ReceiptsDimensions.ReceiptType),
        new("Card batch", "CreditCardBatchNumber", ReceiptsDimensions.CreditCardBatchNumber),
        new("Cashier dept", "CashierStaffDepartmentName", ReceiptsDimensions.CashierStaffDepartment), new("Cashier", "CashierName", ReceiptsDimensions.Cashier),
        new("Server dept", "ServerStaffDepartmentName", ReceiptsDimensions.ServerStaffDepartment), new("Server", "ServerName", ReceiptsDimensions.Server),
        new("Check", "CheckNumber", ReceiptsDimensions.CheckNumber), new("Day", "DayName", ReceiptsDimensions.DayName),
        new("Week", "WeekName", ReceiptsDimensions.WeekName), new("Session", "CashierSessionNumber", ReceiptsDimensions.CashierSessionNumber),
        new("Hour", "DayHourName", ReceiptsDimensions.DayHourNumber),
    ];

    private DDReview.Web.UserContext? ctx;
    private bool allowed, busy;
    private bool weekdays = true;   // the old page opened with Weekdays on: labels down the left, Mon..Sun and a Total across
    private IReadOnlyList<StoreInfo> stores = [];
    private readonly HashSet<int> selected = [];
    private static readonly IReadOnlyList<DrillColumn> Cat = DrillCatalogs.Receipts;
    private readonly DrillState state = NewState();
    private static DrillState NewState() { var s = new DrillState(); s.Flags.Add("Store"); return s; }
    private readonly DrillKeyResolver resolver = new();
    private DateTime start = DateTime.Today.AddDays(-7), end = DateTime.Today.AddDays(-1);
    private string? error;
    private DataTable? result;
    private ReceiptsDimensions ranDims; private DateTime rangeStart, rangeEnd;

    protected override async Task OnInitializedAsync()
    {
        ctx = await Users.GetAsync();
        if (ctx is null) return;
        allowed = ctx.Access.Administrator || ctx.Access.CanSee(ReportKind.Receipts);
        if (!allowed) return;
        stores = await StoreLookup.LoadAuthorizedAsync(ctx.ClientConnectionString, ctx.Access, ReportKind.Receipts);
        foreach (var s in stores) selected.Add(s.StoreId);
    }

    private void Toggle(int id, bool on) { if (on) selected.Add(id); else selected.Remove(id); }
    private void ToggleDim(ReceiptsDimensions d, bool on) { if (on) state.Flags.Add(d.ToString()); else state.Flags.Remove(d.ToString()); }

    private async Task Act(Action<DrillState> change) { change(state); await ExecuteAsync(); }
    private async Task RowClick(DrillColumn dc, DataRow row)
    {
        if (ctx is null || busy) return;
        var v = await resolver.ResolveAsync(ctx.ClientConnectionString, dc, row, checkedRows);
        if (v.Length == 0) return;
        state.RowClick(Cat, dc.Key, v);
        await ExecuteAsync();
    }
    private readonly HashSet<DataRow> checkedRows = [];
    private static bool CanClick(DataRow row, DrillColumn dc) => DrillKeyResolver.CanClick(row, dc);
    private void Check(DataRow row, bool on) { if (on) checkedRows.Add(row); else checkedRows.Remove(row); }
    private static string WeekKey(string label) => "wk/" + label;
    private void SortWeek(string? label)
    {
        if (string.IsNullOrEmpty(label)) { state.SortHeader = null; return; }
        state.Sort(WeekKey(label), true);
    }
    private static string LineKey(StackColumn c, StackLine line) => c.Title + "/" + line.Label;
    private string Mark(string key) => state.SortHeader == key ? (state.SortDescending ? " ▼" : " ▲") : "";
    private IEnumerable<DataRow> Ordered()
    {
        if (result is null) return [];
        var h = state.SortHeader;
        if (h is null) return result.Rows.Cast<DataRow>();
        var lead = Leading.FirstOrDefault(l => l.Label == h);
        if (lead is not null)
        {
            var dc = DrillState.ForDisplay(Cat, lead.Column);
            return GridSort.Rows(result, GridSort.Column(result, dc?.SortColumn is not null && result.Columns.Contains(dc.SortColumn) ? dc.SortColumn : lead.Column), state.SortDescending);
        }
        if (h.StartsWith("wk/"))
        {
            var wl = ReceiptsWeekdays.Lines.FirstOrDefault(x => WeekKey(x.Label) == h);
            if (wl is null) return result.Rows.Cast<DataRow>();
            return GridSort.Rows(result, wl.Ratio ? GridSort.Column(result, wl.TotalField, wl.TotalDenominator) : GridSort.Column(result, wl.TotalField), state.SortDescending);
        }
        foreach (var c in ReceiptsLayout.Columns)
            foreach (var line in c.Lines)
                if (LineKey(c, line) == h)
                    return GridSort.Rows(result, line.Format == CellFormat.Percent ? GridSort.Column(result, line.NumeratorColumn!, line.DenominatorColumn) : GridSort.Column(result, line.Column), state.SortDescending);
        return result.Rows.Cast<DataRow>();
    }
    private static string Text(DataRow row, string col) => row.Table.Columns.Contains(col) && row[col] is not DBNull ? row[col].ToString() ?? "" : "";

    /// <summary>The Submit button: runs again with the filters kept (clear one with its box's ✕); the sort starts over.</summary>
    private async Task RunAsync() { state.SortHeader = null; await ExecuteAsync(); }

    private async Task ExecuteAsync()
    {
        if (ctx is null || busy) return;
        error = null; result = null; header = null; checkedRows.Clear();
        var dims = state.Dimensions<ReceiptsDimensions>();
        var allowedIds = stores.Select(s => s.StoreId).ToHashSet();                         // re-check against the access list
        var (ids, lists) = DrillFilters.Split(state, Cat, selected.Where(allowedIds.Contains));
        if (ids.Count == 0) { error = "Pick at least one store."; return; }
        if (end < start) { error = "The end date is before the start date."; return; }
        busy = true;
        try
        {
            var req = new ReceiptsRequest(DateOnly.FromDateTime(start), DateOnly.FromDateTime(end), dims, ids,
                lists.Count == 0 ? null : lists.ToDictionary(kv => Enum.Parse<ReceiptsDimensions>(kv.Key), kv => kv.Value));
            var runTask = ReceiptsSvc.RunAsync(ctx.ClientConnectionString, req);
            var headTask = state.Filters.Count == 0 ? Task.FromResult<DataRow?>(null) : ReceiptsSvc.HeaderAsync(ctx.ClientConnectionString, req);
            result = await runTask; header = await headTask;
            ranDims = dims; rangeStart = start; rangeEnd = end;
        }
        catch (Exception ex) { error = "The query failed: " + ex.Message; }
        finally { busy = false; }
    }

    private async Task Shift(int dir)
    {
        (start, end) = DDReview.Core.DateRules.Shift(start, end, dir, DDReview.Core.DateRules.Yesterday);
        await ExecuteAsync();
    }
    private async Task ExcelAsync()
    {
        if (result is null) return;
        var lead = AllLeading.Where(l => ranDims.HasFlag(l.Dim)).Select(l => (l.Label, l.Column)).ToList();
        var (h, rows) = ReceiptsExport.Build(result, lead);
        var bytes = DDReview.Core.Support.XlsxWriter.Write("Receipts", $"Receipts review {rangeStart:MM/dd/yyyy} - {rangeEnd:MM/dd/yyyy}", h, rows, null, FilterHeader.Describe(Boxes()));
        await JS.InvokeVoidAsync("ddDownload", $"ReceiptsReview_{rangeStart:yyyyMMdd}_{rangeEnd:yyyyMMdd}.xlsx", Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}
