@page "/"
@attribute [Authorize]
@inject UserContextService Users

<PageTitle>DD Review</PageTitle>
<h1>DD Review</h1>
@if (ctx is null)
{
    <p>Loading…</p>
}
else
{
    <p>Signed in as <strong>@ctx.UserName</strong>.</p>
    <ul class="menu">
        @if (ctx.Access.CanSee(DDReview.Core.Tenancy.ReportKind.Sales))
        {
            <li><a href="/sales">Sales review</a></li>
        }
        @if (ctx.Access.CanSee(DDReview.Core.Tenancy.ReportKind.Receipts))
        {
            <li><a href="/receipts">Receipts review</a></li>
        }
        @if (ctx.Access.CanSee(DDReview.Core.Tenancy.ReportKind.DebitCredit))
        {
            <li><a href="/gl">General ledger review</a></li>
        }
    </ul>
}

@code {
    private DDReview.Web.UserContext? ctx;
    protected override async Task OnInitializedAsync() => ctx = await Users.GetAsync();
}
