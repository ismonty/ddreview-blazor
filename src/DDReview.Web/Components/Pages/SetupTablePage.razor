@page "/admin/setup/table/{Id}"
@attribute [Authorize]
@using DDReview.Core.Admin
@using DDReview.Web.Components.Setup

<PageTitle>MontySoft DD Review™</PageTitle>
@if (Table is null)
{
    <h1>Setup</h1>
    <p>That Setup page does not exist. <a href="/admin/setup">Back to Setup</a></p>
}
else
{
    <h1>@Table.Title</h1>
    <p><a href="/admin/setup">&larr; Setup</a>@if (Table.Id == "receipt-types") { <text> · <a href="@SetupCatalog.ReceiptTypesRoute">Tile editor</a></text> }@if (Table.Id == "sales-accounts") { <text> · <a href="@SetupCatalog.SalesAccountsRoute">Tile editor</a></text> }</p>
    <SetupGate Area="Table.Area">
        <SetupGrid Table="Table" />
    </SetupGate>
}

@code {
    [Parameter] public string? Id { get; set; }
    private SetupTable? Table => SetupTables.Find(Id);
}
