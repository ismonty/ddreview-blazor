@page "/login"
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Components.Forms
@inject DDReview.Web.GoogleSignInStatus GoogleStatus

<PageTitle>MontySoft DD Review™</PageTitle>
<div class="login-card">
    <h1>DD Review</h1>
    <p class="muted">Online reporting for Digital Dining</p>
    @if (Error is not null)
    {
        <p class="error" role="alert">@Message</p>
    }
    <form method="post" action="/account/login">
        <AntiforgeryToken />
        <label>User name or email<input name="userName" autocomplete="username" maxlength="250" required autofocus /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" maxlength="200" required /></label>
        <button type="submit">Sign in</button>
    </form>
    @if (GoogleStatus.Enabled)
    {
        <form method="post" action="/account/google/start" class="google">
            <AntiforgeryToken />
            <input type="hidden" name="mode" value="signin" />
            <p class="muted">or</p>
            <button type="submit" class="secondary">Sign in with Google</button>
        </form>
        <p class="muted small google-out">Shared computer? <a href="https://accounts.google.com/Logout" target="_blank" rel="noopener" title="Signs every Google account out of this browser, so the next Google sign-in asks for the email and password">Sign Out of Google</a></p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "e")] public string? Error { get; set; }
    private string Message => Error switch
    {
        "locked" => "Too many failed attempts. Try again in 15 minutes.",
        "nodb" => "Your account has no database assigned. Please contact support.",
        "google" => "Google sign-in did not complete. Please try again.",
        "nogoogle" => "That Google account is not linked to a DD Review login. Sign in with your password, then open your name at the top and choose Link Google account.",
        _ => "Invalid login.",
    };
}
