@using DDReview.Core.Admin
@using DDReview.Core.Gl
@using DDReview.Core.Tenancy
@inject GlAdjustmentService Svc

@* The Adjust Sales and Adjust GL windows over the General Ledger Review. All rules (store access, validation, audit) are in GlAdjustmentService; this only collects the typing. *@
<div class="sub-overlay" role="dialog" aria-label="@Title">
    <div class="sub-panel">
        <div class="sub-bar">
            <strong>@Title</strong>
            <span class="sub-bar-buttons"><button type="button" @onclick="CloseAsync">Close</button></span>
        </div>
        <p class="muted">@(Kind == AdjustKind.Sales
            ? "Adjust Sales changes a sales amount before the sales tax is worked out, so the tax and the totals follow it."
            : "Adjust GL adds a ledger line after the sales tax is worked out. Sales and tax are not changed.")
            @(Kind == AdjustKind.Sales ? "Each line takes the amount from the sales account chosen and puts it into the offset account." : "") The report is run again when you close this window.</p>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        @if (data is null && error is null) { <p>Loading…</p> }
        else if (data is not null && data.Batches.Count == 0) { <p class="muted">There are no batches for these stores and dates.</p> }
        else if (data is not null)
        {
            <table class="adj">
                @if (Kind == AdjustKind.Gl)
                {
                    <thead><tr><th>Batch</th><th>Account</th><th class="n">Debit</th><th class="n">Credit</th><th>Reference</th><th class="n">Sort</th><th>Bank Rec Account</th><th>Class</th><th>Vendor</th><th>Debit/Credit Flag</th><th>QuickBooks Type</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in data.Gl)
                    {
                        @if (draft is not null && draft.ItemId == r.ItemId) { @GlEditor() }
                        else
                        {
                            <tr>
                                <td data-label="Batch">@BatchLabel(r.BatchId)</td><td data-label="Account">@r.Account</td><td class="n" data-label="Debit">@(r.Debit is > 0 ? r.Debit.Value.ToString("N2") : "")</td><td class="n" data-label="Credit">@(r.Credit is > 0 ? r.Credit.Value.ToString("N2") : "")</td>
                                <td data-label="Reference">@r.DistReference</td><td class="n" data-label="Sort">@r.Sorter</td><td data-label="Bank Rec Account">@r.BankRecAccount</td><td data-label="Class">@ClassName(r.AccountClassId)</td><td data-label="Vendor">@r.Vendor</td><td data-label="Debit/Credit Flag">@(r.DebitCreditFlag == 1 ? "Debit" : r.DebitCreditFlag == -1 ? "Credit" : r.DebitCreditFlag.ToString())</td><td data-label="QuickBooks Type">@r.DefaultAccountType</td>
                                <td class="nowrap">@RowButtons(r.ItemId, () => EditGl(r), () => RemoveGlAsync(r))</td>
                            </tr>
                        }
                    }
                    @if (draft is not null && draft.ItemId == 0) { @GlEditor() }
                    </tbody>
                }
                else
                {
                    <thead><tr><th>Batch</th><th>Sales Account</th><th class="n">Sales Amount</th><th>Offset Account</th><th>Offset Class</th><th>Offset Reference</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in data.Sales)
                    {
                        @if (draft is not null && draft.ItemId == r.ItemId) { @SalesEditor() }
                        else
                        {
                            <tr>
                                <td data-label="Batch">@BatchLabel(r.BatchId)</td><td data-label="Sales Account">@CreditName(r.CreditAccountId)</td><td class="n" data-label="Sales Amount">@r.SalesAmount?.ToString("N2")</td><td data-label="Offset Account">@r.OffsetAccount</td><td data-label="Offset Class">@ClassName(r.OffsetAccountClassId)</td><td data-label="Offset Reference">@r.OffsetDistReference</td>
                                <td class="nowrap">@RowButtons(r.ItemId, () => EditSales(r), () => RemoveSalesAsync(r))</td>
                            </tr>
                        }
                    }
                    @if (draft is not null && draft.ItemId == 0) { @SalesEditor() }
                    </tbody>
                }
            </table>
            @if (draft is null || draft.ItemId == 0)
            {
                <p>@if (draft is null) { <button type="button" @onclick="StartAdd" disabled="@busy">Add an Adjustment</button> }
                   @if (Kind == AdjustKind.Gl) { <button type="button" class="secondary" @onclick="AddOverShort" disabled="@busy" title="Starts a line for this store's over/short account (receipt type 999); you enter the amount">Add Over/Short</button> }</p>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AdjustKind Kind { get; set; }
    [Parameter, EditorRequired] public string ConnectionString { get; set; } = "";
    [Parameter, EditorRequired] public GlRequest Request { get; set; } = default!;
    [Parameter, EditorRequired] public SetupActor Actor { get; set; } = default!;
    /// <summary>null = every store; otherwise the stores this person may see (the same rule as the General Ledger Review itself).</summary>
    [Parameter] public string? AllowedStores { get; set; }
    /// <summary>Called when the window closes; true when anything was saved, so the report should be run again.</summary>
    [Parameter] public EventCallback<bool> OnClosed { get; set; }
    /// <summary>A ledger line the person double-clicked (Adjust GL only): the add form opens already filled in from it.</summary>
    [Parameter] public AdjustSeed? Seed { get; set; }
    /// <summary>How far each batch was off (debits less credits) when the report was run; Add Over/Short enters the amount that offsets it.</summary>
    [Parameter] public IReadOnlyDictionary<int, decimal>? BatchDifferences { get; set; }

    private sealed class Draft
    {
        public int ItemId; public int BatchId; public int ClassId; public int CreditAccountId; public short Flag;
        public string Account = "", Debit = "", Credit = "", Reference = "", Sort = "", BankRec = "", Vendor = "", Type = "", Amount = "";
    }

    private AdjustData? data;
    private Draft? draft;
    private string? error;
    private bool busy, changed;
    private GlAdjustRow? origGl;
    private SalesAdjustRow? origSales;

    private string Title => Kind == AdjustKind.Gl ? "Adjust GL" : "Adjust Sales";

    private readonly Dictionary<int, decimal> adjustedAtOpen = [];   // debits less credits of each batch's adjustment lines when this window opened

    private decimal AdjustmentNet(int batchId) => data!.Gl.Where(g => g.BatchId == batchId).Sum(g => (g.Debit ?? 0) - (g.Credit ?? 0));

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        if (data is not null) foreach (var b in data.Batches) adjustedAtOpen[b.BatchId] = AdjustmentNet(b.BatchId);
        if (Seed is { } seed && Kind == AdjustKind.Gl && data is { Batches.Count: > 0 })
        {
            StartAdd();
            var d = draft!;
            if (data.Batches.Any(b => b.BatchId == seed.BatchId)) d.BatchId = seed.BatchId;
            d.Account = seed.Account?.Trim() ?? ""; d.Reference = seed.DistReference?.Trim() ?? ""; d.Flag = seed.DebitCreditFlag;
            var cls = data.Classes.FirstOrDefault(c => string.Equals(c.Name, seed.AccountClass?.Trim(), StringComparison.OrdinalIgnoreCase));
            if (cls is not null) d.ClassId = cls.Id;
        }
    }

    private async Task ReloadAsync()
    {
        try { data = await Svc.LoadAsync(ConnectionString, Request, AllowedStores); }
        catch (Microsoft.Data.SqlClient.SqlException) { error = "The adjustments are not available in this database."; }
        catch (Exception ex) { error = "The adjustments could not be loaded: " + ex.Message; }
    }

    private string BatchLabel(int id) => data?.Batches.FirstOrDefault(b => b.BatchId == id)?.Label ?? ("Batch " + id);
    private string ClassName(int id) => data?.Classes.FirstOrDefault(c => c.Id == id)?.Name ?? id.ToString();
    private string CreditName(int id) => data?.CreditAccounts.FirstOrDefault(c => c.CreditAccountId == id)?.Label ?? id.ToString();
    private IEnumerable<CreditAccountChoice> CreditsFor(int batchId)
    {
        var store = data?.Batches.FirstOrDefault(b => b.BatchId == batchId)?.StoreId;
        return data!.CreditAccounts.Where(c => c.StoreId == store);
    }

    private void StartAdd()
    {
        error = null; origGl = null; origSales = null;
        draft = new Draft { ItemId = 0, BatchId = data!.Batches[0].BatchId, ClassId = data.Classes.FirstOrDefault()?.Id ?? 0 };
    }

    /// <summary>Starts (or fills) a new line from the over/short account of the batch's store: account, reference, class and QuickBooks type from receipt type 999. The amount is left for the person.</summary>
    private void AddOverShort()
    {
        if (data is null || data.Batches.Count == 0) return;
        var batchId = draft is { ItemId: 0 } ? draft.BatchId : (Seed?.BatchId is int sb && data.Batches.Any(b => b.BatchId == sb) ? sb : data.Batches[0].BatchId);
        if (draft is not { ItemId: 0 }) StartAdd();
        var d = draft!;
        d.BatchId = batchId;
        var store = data.Batches.First(b => b.BatchId == batchId);
        var os = data.OverShort?.FirstOrDefault(o => o.StoreId == store.StoreId);
        if (os is null) { error = $"{store.StoreName} has no over/short receipt type (ID 999) with a debit account, so there is nothing to copy. Add one in Receipt Account Mapping."; return; }
        error = null;
        d.Account = os.Account; d.Reference = os.DistReference ?? ""; d.Type = os.QuickBooksType; d.Flag = 1;
        // The batch's difference as the report showed it, moved by whatever adjustments were added or changed since: the amount that offsets what is still off.
        d.Debit = d.Credit = "";
        if (BatchDifferences is not null && BatchDifferences.TryGetValue(batchId, out var off))
        {
            var (debit, credit) = GlAdjustmentService.OffsetFor(off + AdjustmentNet(batchId) - adjustedAtOpen.GetValueOrDefault(batchId));
            if (credit is decimal c) d.Credit = c.ToString("0.00");   // debits are ahead, so credit the difference
            if (debit is decimal db) d.Debit = db.ToString("0.00");   // credits are ahead, so debit the difference
        }
        if (os.AccountClassId != 0 && data.Classes.Any(c => c.Id == os.AccountClassId)) d.ClassId = os.AccountClassId;
    }

    private void EditGl(GlAdjustRow r)
    {
        error = null; origGl = r; origSales = null;
        draft = new Draft { ItemId = r.ItemId, BatchId = r.BatchId, Account = r.Account ?? "", Debit = r.Debit is > 0 ? r.Debit.Value.ToString("0.00") : "", Credit = r.Credit is > 0 ? r.Credit.Value.ToString("0.00") : "",
            Reference = r.DistReference ?? "", Sort = r.Sorter?.ToString() ?? "", BankRec = r.BankRecAccount ?? "", ClassId = r.AccountClassId, Vendor = r.Vendor ?? "", Flag = r.DebitCreditFlag, Type = r.DefaultAccountType ?? "" };
    }

    private void EditSales(SalesAdjustRow r)
    {
        error = null; origSales = r; origGl = null;
        draft = new Draft { ItemId = r.ItemId, BatchId = r.BatchId, CreditAccountId = r.CreditAccountId, Amount = r.SalesAmount?.ToString("0.00") ?? "", Account = r.OffsetAccount ?? "", ClassId = r.OffsetAccountClassId, Reference = r.OffsetDistReference ?? "" };
    }

    private void Cancel() { draft = null; origGl = null; origSales = null; error = null; }

    private async Task Run(Func<Task> work)
    {
        busy = true; error = null;
        try { await work(); changed = true; draft = null; origGl = null; origSales = null; await ReloadAsync(); }
        catch (GlAdjustmentException ex) { error = ex.Message; }
        catch (Microsoft.Data.SqlClient.SqlException) { error = "The change could not be saved."; }
        busy = false;
    }

    private Task SaveAsync() => Run(async () =>
    {
        var d = draft!;
        if (Kind == AdjustKind.Gl)
        {
            if (!AdjustValidation.TryMoney(d.Debit, out var debit) || !AdjustValidation.TryMoney(d.Credit, out var credit)) throw new GlAdjustmentException("Enter amounts as numbers with at most two decimals.");
            int? sorter = null;
            if (!string.IsNullOrWhiteSpace(d.Sort)) { if (!int.TryParse(d.Sort, out var n)) throw new GlAdjustmentException("The sort number must be a whole number."); sorter = n; }
            var row = new GlAdjustRow(d.ItemId, d.BatchId, d.Account, debit, credit, d.Reference, sorter, d.BankRec, d.ClassId, d.Vendor, d.Flag, d.Type);
            if (origGl is null) await Svc.AddAsync(ConnectionString, Actor, AllowedStores, row);
            else await Svc.ChangeAsync(ConnectionString, Actor, AllowedStores, origGl, row);
        }
        else
        {
            if (!AdjustValidation.TryMoney(d.Amount, out var amount)) throw new GlAdjustmentException("Enter the amount as a number with at most two decimals.");
            var row = new SalesAdjustRow(d.ItemId, d.BatchId, d.CreditAccountId, amount, d.Account, d.ClassId, d.Reference);
            if (origSales is null) await Svc.AddAsync(ConnectionString, Actor, AllowedStores, row);
            else await Svc.ChangeAsync(ConnectionString, Actor, AllowedStores, origSales, row);
        }
    });

    private Task RemoveGlAsync(GlAdjustRow r) => Run(() => Svc.RemoveAsync(ConnectionString, Actor, AllowedStores, r));
    private Task RemoveSalesAsync(SalesAdjustRow r) => Run(() => Svc.RemoveAsync(ConnectionString, Actor, AllowedStores, r));

    private int? confirmId;
    private RenderFragment RowButtons(int itemId, Action edit, Func<Task> remove) => @<text>
        @if (confirmId == itemId)
        {
            <span>Delete this line?</span>
            <button type="button" disabled="@busy" @onclick="async () => { confirmId = null; await remove(); }">Yes</button>
            <button type="button" class="secondary" @onclick="() => confirmId = null">No</button>
        }
        else if (draft is null)
        {
            <button type="button" class="secondary" @onclick="edit">Edit</button>
            <button type="button" class="secondary" @onclick="() => confirmId = itemId">Delete</button>
        }
    </text>;

    private RenderFragment GlEditor() => @<tr class="adj-edit">
        <td data-label="Batch"><select @bind="draft!.BatchId">@foreach (var b in data!.Batches) {<option value="@b.BatchId">@b.Label</option>}</select></td>
        <td data-label="Account"><input @bind="draft!.Account" maxlength="100" aria-label="Account" /></td>
        <td class="n" data-label="Debit"><input @bind="draft!.Debit" inputmode="decimal" size="9" aria-label="Debit" /></td>
        <td class="n" data-label="Credit"><input @bind="draft!.Credit" inputmode="decimal" size="9" aria-label="Credit" /></td>
        <td data-label="Reference"><input @bind="draft!.Reference" maxlength="100" aria-label="Reference" /></td>
        <td class="n" data-label="Sort"><input @bind="draft!.Sort" inputmode="numeric" size="5" aria-label="Sort" /></td>
        <td data-label="Bank Rec Account"><input @bind="draft!.BankRec" maxlength="50" aria-label="Bank rec account" /></td>
        <td data-label="Class"><select @bind="draft!.ClassId">@foreach (var c in data!.Classes) {<option value="@c.Id">@c.Name</option>}</select></td>
        <td data-label="Vendor"><input @bind="draft!.Vendor" maxlength="50" aria-label="Vendor" /></td>
        <td data-label="Debit/Credit Flag"><select @bind="draft!.Flag" aria-label="Debit/Credit Flag"><option value="0">(none)</option><option value="1">Debit</option><option value="-1">Credit</option></select></td>
        <td data-label="QuickBooks Type"><select @bind="draft!.Type" aria-label="QuickBooks type"><option value="">(none)</option>
            @if (draft!.Type.Length > 0 && !SetupTables.QuickBooksTypes.Contains(draft.Type)) {<option value="@draft.Type">@draft.Type</option>}
            @foreach (var t in SetupTables.QuickBooksTypes) {<option value="@t">@t</option>}</select></td>
        <td class="nowrap"><button type="button" disabled="@busy" @onclick="SaveAsync">Save</button> <button type="button" class="secondary" @onclick="Cancel">Cancel</button></td>
    </tr>;

    private RenderFragment SalesEditor() => @<tr class="adj-edit">
        <td data-label="Batch"><select @bind="draft!.BatchId">@foreach (var b in data!.Batches) {<option value="@b.BatchId">@b.Label</option>}</select></td>
        <td data-label="Sales Account"><select @bind="draft!.CreditAccountId"><option value="0">Choose…</option>@foreach (var c in CreditsFor(draft!.BatchId)) {<option value="@c.CreditAccountId">@c.Label</option>}</select></td>
        <td class="n" data-label="Sales Amount"><input @bind="draft!.Amount" inputmode="decimal" size="10" aria-label="Sales amount" /></td>
        <td data-label="Offset Account"><input @bind="draft!.Account" maxlength="100" aria-label="Offset account" /></td>
        <td data-label="Offset Class"><select @bind="draft!.ClassId">@foreach (var c in data!.Classes) {<option value="@c.Id">@c.Name</option>}</select></td>
        <td data-label="Offset Reference"><input @bind="draft!.Reference" maxlength="100" aria-label="Offset reference" /></td>
        <td class="nowrap"><button type="button" disabled="@busy" @onclick="SaveAsync">Save</button> <button type="button" class="secondary" @onclick="Cancel">Cancel</button></td>
    </tr>;

    private Task CloseAsync() => OnClosed.InvokeAsync(changed);
}
