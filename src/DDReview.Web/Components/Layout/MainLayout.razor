@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<DDReview.Core.Legacy.LegacyProxyOptions> Legacy

<header class="top">
    <a href="/" class="brand">DD Review</a>
    <AuthorizeView>
        <Authorized>
            <nav><a href="/sales">Sales</a> <a href="/receipts">Receipts</a> <a href="/labor">Labor</a> <a href="/gl">General ledger</a>@if (Legacy.Value.Enabled) {<text> <a href="/classic-enter?to=@Uri.EscapeDataString(Legacy.Value.PathPrefix + "/Default.aspx")" target="_blank" rel="noopener" title="Opens the classic DDReview in a new tab">Classic&nbsp;&#8599;</a></text>}</nav>
            <form method="post" action="/account/logout" class="logout">
                <AntiforgeryToken />
                <a href="/account" title="Your account">@context.User.Identity?.Name</a>
                <button type="submit">Sign out</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>
<main>@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
