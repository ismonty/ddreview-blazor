@inherits LayoutComponentBase
@inject DDReview.Web.UserContextService Users
@inject DDReview.Core.Features.FeatureService Features

<header class="top">
    <a href="/" class="brand">DD Review</a>
    <AuthorizeView>
        <Authorized>
            <nav><a href="/sales">Sales</a> <a href="/receipts">Receipts</a> <a href="/labor">Labor</a>@if (showPayroll) { <text> <a href="/payroll">Payroll</a></text> }@if (showConsolidated) { <text> <a href="/consolidated">Consolidated payroll</a></text> } <a href="/gl">General ledger</a></nav>
            <form method="post" action="/account/logout" class="logout">
                <AntiforgeryToken />
                <a href="/account" title="Your account">@context.User.Identity?.Name</a>
                <button type="submit">Sign out</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>
<main>@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool showPayroll, showConsolidated;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var ctx = await Users.GetAsync();
            var on = ctx is null ? new HashSet<DDReview.Core.Features.WebFeature>() : await Features.EnabledForAsync(ctx.ClientConnectionString, ctx.Access);
            showPayroll = on.Contains(DDReview.Core.Features.WebFeature.Payroll);
            showConsolidated = on.Contains(DDReview.Core.Features.WebFeature.ConsolidatedPayroll);
        }
        catch (Exception ex) when (ex is Microsoft.Data.SqlClient.SqlException or InvalidOperationException) { showPayroll = showConsolidated = false; }
    }
}
