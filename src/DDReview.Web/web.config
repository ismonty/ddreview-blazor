<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\DDReview.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- Blazor Server talks over a WebSocket. Do not add a <webSocket> element here: IIS locks that section
           (500.19, 0x80070021). Installing the IIS WebSocket Protocol feature is all it needs. -->
    </system.webServer>
  </location>
</configuration>
