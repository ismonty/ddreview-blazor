<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user installer for DDQuickBooksPoster.exe (WiX 5). Built by deploy/Publish-Poster.ps1; see docs/QUICKBOOKS.md.
    - Installs to %LocalAppData%\DDReview\QuickBooksPoster for the current Windows user only: no administrator rights, no prompts.
    - Adds a Start menu shortcut and registers the ddposter: link and the .ddposter and .ddpackage file types for that user, so the website can open the program.
    - A newer installer upgrades the old one in place (settings live under the user's profile and are kept). Uninstalling removes all of it.
  The upgrade code below must never change: it is how Windows knows a new installer is the same product.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DD Review QuickBooks Poster" Manufacturer="MontySoft" Version="$(var.Version)"
           UpgradeCode="6f1d0c52-8d1b-4f0c-9a53-5b0d6c8e2a41" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of the QuickBooks poster is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="VendorFolder" Name="DDReview">
        <Directory Id="INSTALLFOLDER" Name="QuickBooksPoster" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Every file of the published (self-contained, win-x86) program. -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.publish)\**" />
    </ComponentGroup>

    <!-- Start menu shortcut. -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="PosterShortcut" Name="DD Review QuickBooks Poster" Description="Posts the DD Review general ledger and A/R into QuickBooks Desktop"
                Target="[INSTALLFOLDER]DDQuickBooksPoster.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\DDReview\QuickBooksPoster" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ddposter: links and .ddposter files. The command text must match what the program itself writes (ProtocolCommand.Build), so it sees itself as registered. -->
    <Component Id="LinkRegistration" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCU" Key="Software\Classes\ddposter">
        <RegistryValue Type="string" Value="URL:DD Review QuickBooks Poster" />
        <RegistryValue Name="URL Protocol" Type="string" Value="" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]DDQuickBooksPoster.exe&quot;,0" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]DDQuickBooksPoster.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\.ddposter">
        <RegistryValue Type="string" Value="DDReview.QuickBooksPoster.LaunchFile" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\DDReview.QuickBooksPoster.LaunchFile">
        <RegistryValue Type="string" Value="DD Review QuickBooks launch file" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]DDQuickBooksPoster.exe&quot;,0" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]DDQuickBooksPoster.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\.ddpackage">
        <RegistryValue Type="string" Value="DDReview.QuickBooksPoster.Package" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\DDReview.QuickBooksPoster.Package">
        <RegistryValue Type="string" Value="DD Review QuickBooks package" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]DDQuickBooksPoster.exe&quot;,0" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]DDQuickBooksPoster.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
      <RegistryValue Root="HKCU" Key="Software\DDReview\QuickBooksPoster" Name="Links" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- The program folders are removed on uninstall only if nothing else is in them. -->
    <Component Id="CleanUpFolders" Directory="INSTALLFOLDER">
      <RemoveFolder Id="RemoveInstall" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveVendor" Directory="VendorFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\DDReview\QuickBooksPoster" Name="Folders" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="DD Review QuickBooks Poster" Level="1">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="LinkRegistration" />
      <ComponentRef Id="CleanUpFolders" />
    </Feature>
  </Package>
</Wix>
